FLASK_APP=app
FLASK_ENV=development
SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql://user:password@localhost:5432/ntu_pool
MAIL_SERVER=smtp.googlemail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-password
NEA_API_KEY=your-nea-api-key
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DOCS_TABLE=pool_documents
SUPABASE_MATCH_FUNCTION=match_documents
CHATBOT_TOP_K=3
CHATBOT_MIN_SCORE=0.65
CHATBOT_MAX_CONTEXT_CHARS=4000
