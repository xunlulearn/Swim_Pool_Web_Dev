FLASK_APP=app
FLASK_ENV=development
SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql://user:password@localhost:5432/ntu_pool
MAIL_SERVER=smtp.googlemail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-password
NEA_API_KEY=your-nea-api-key
USE_SAMPLE_WEATHER_DATA=false
FORCE_SAMPLE_WEATHER_DATA=false
WEATHER_STATUS_CACHE_SECONDS=30
LIGHTNING_SNAPSHOT_CACHE_SECONDS=30
LIGHTNING_HISTORY_CACHE_SECONDS=60
LIGHTNING_HISTORY_MAX_PAGES=0
LIGHTNING_COLLECTOR_ENABLED=true
LIGHTNING_COLLECTOR_INTERVAL_SECONDS=120
LIGHTNING_COLLECTOR_STARTUP_DELAY_SECONDS=5
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
CHATBOT_INTENT_API_KEY=your-openrouter-api-key
CHATBOT_INTENT_BASE_URL=https://openrouter.ai/api/v1
CHATBOT_INTENT_MODEL=liquid/lfm-2.5-1.2b-thinking:free
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DOCS_TABLE=pool_documents
SUPABASE_MATCH_FUNCTION=match_documents
SUPABASE_CHAT_LOG_TABLE=chatbot_conversations
SUPABASE_INTENT_LLM_FAILURE_TABLE=chatbot_intent_model_failures
SUPABASE_QA_LLM_FAILURE_TABLE=chatbot_qa_model_failures
CHATBOT_TOP_K=3
CHATBOT_MIN_SCORE=0.45
CHATBOT_MAX_CONTEXT_CHARS=4000
CHATBOT_DB_TOOL_MAX_CALLS=4
